# Keep all URLs on the same hostname. Prefer 127.0.0.1 throughout.
STARVIEW_ORIGIN=http://127.0.0.1:5173
STARVIEW_API_ORIGIN=http://127.0.0.1:8000
# Optional private account directory; defaults to ~/.local/share/starview
# STARVIEW_DATA_DIR=/absolute/private/path
# Never commit real credentials. Register web OAuth apps with the callbacks below.
STARVIEW_GOOGLE_CLIENT_ID=
STARVIEW_GOOGLE_CLIENT_SECRET=
STARVIEW_MICROSOFT_CLIENT_ID=
STARVIEW_MICROSOFT_CLIENT_SECRET=

# Local agent defaults (Gemini stays optional, even if a key is configured).
STARVIEW_OLLAMA_MODEL=deepseek-r1:7b
STARVIEW_OLLAMA_FAST_MODEL=deepseek-r1:7b
STARVIEW_EMBED_MODEL=embeddinggemma
# Optional cloud agent; never put keys in frontend VITE_ variables.
# GEMINI_API_KEY=
# STARVIEW_GEMINI_MODEL=gemini-3.8-flash
